{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "modules-left": ["custom/apple", "hyprland/window", "hyprland/workspaces"],
  "modules-center": [],
  "modules-right": ["tray", "pulseaudio", "network", "battery", "clock", "custom/notif"],

  "custom/apple": {
    "format": "",
    "tooltip": false,
    "on-click": "wofi --show drun"
  },
  "hyprland/window": {
    "format": "{class}",
    "max-length": 30,
    "rewrite": { "": "Bureau" },
    "separate-outputs": true
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": { "active": "●", "default": "○" },
    "on-click": "activate"
  },
  "tray": { "spacing": 10 },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "tooltip-format": "Volume : {volume}%",
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format": "{ifname} — {ipaddr}"
  },
  "battery": {
    "format": "{icon}  {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "locale": "fr_FR.UTF-8",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "custom/notif": {
    "format": "󰂚",
    "tooltip": false,
    "on-click": "swaync-client -t -sw"
  }
}
